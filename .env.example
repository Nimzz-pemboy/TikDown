# Site identity (name, URL, description, logo, repo link) is no longer read
# from env — edit src/config/site.ts directly to rebrand.

# Optional: Go downloader service. When empty, the Node/TS extractor runs in-process.
GO_SERVICE_URL=

# Optional shared secret sent to the Go service as x-api-secret
API_SECRET=

# Optional: Redis for distributed rate limit / cache (default is in-memory)
REDIS_URL=

# CORS: restrict the API to one origin in production, e.g. https://tikdown.example.com
ALLOWED_ORIGIN=*

NODE_ENV=development
